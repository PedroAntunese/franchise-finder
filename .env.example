# Copie para .env e preencha os valores. Nunca versione o .env.

# Backend
# 3001 para não colidir com o frontend (Create React App usa 3000)
PORT=3001
NODE_ENV=development

# Banco de dados (MySQL no Aiven)
DB_HOST=
DB_PORT=0000
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=

# Autenticação (JWT)
# Gere um segredo longo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=

# Frontend (Create React App)
REACT_APP_API_URL=http://localhost:3001/api
